# --- Ports -----------------------------------------------------------------
# API_PORT     backend (src/apps/api, Express)
# PORTAL_PORT  customer & reseller portal (src/apps/portal)
# ADMIN_PORT   isolated platform admin console (src/apps/admin)
# SIMULATOR_PORT device simulator UI
# SIMULATOR_CONTROL_PORT device simulator browser-session control service
# TELEMATICS_PORT Coban GPS 303FG TCP/UDP gateway
# WEB_HOST     host interface the three Vite dev servers bind
API_PORT=8787
PORTAL_PORT=5173
ADMIN_PORT=5174
SIMULATOR_PORT=5175
SIMULATOR_CONTROL_PORT=5176
TELEMATICS_PORT=8090
WEB_HOST=127.0.0.1

HOST=0.0.0.0
NODE_ENV=development

# Keep in sync with PORTAL_PORT / ADMIN_PORT / SIMULATOR_PORT.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
VITE_API_BASE=http://localhost:8787

# --- Database (PostgreSQL) -------------------------------------------------
# `npm run dev` falls back to SQLite when this server is unreachable.
# Start it explicitly with `docker compose up -d --wait db` (image: postgres:latest).
# DATABASE_URL takes precedence over DATABASE_HOST/DATABASE_PORT when set.
DATABASE_DIALECT=postgres
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sentinel
DATABASE_USER=sentinel
DATABASE_PASSWORD=sentinel
DATABASE_LOGGING=false

# SQLite is still supported as an optional offline fallback: set
# DATABASE_DIALECT=sqlite, clear DATABASE_URL and use DATABASE_STORAGE.
# DATABASE_STORAGE=../../../.data/sentinel.sqlite
