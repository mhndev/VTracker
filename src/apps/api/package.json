{
  "name": "@sentinel/api",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx src/database/migrate-cli.ts up",
    "db:migrate:status": "tsx src/database/migrate-cli.ts status",
    "db:migrate:undo": "tsx src/database/migrate-cli.ts down",
    "test": "NODE_ENV=test DATABASE_STORAGE=:memory: tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "latest",
    "express": "5.2.1",
    "pg": "8.13.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "8.15.6",
    "@types/supertest": "latest",
    "supertest": "latest",
    "tsx": "4.23.15",
    "typescript": "latest"
  }
}
